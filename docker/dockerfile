FROM node:22.23.4-alpine3.23 AS builder
RUN npm install --global npm@12.2.1

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN npm run build -- --configuration production

FROM node:22.23.4-alpine3.23

WORKDIR /app

COPY docker/serve/package*.json /opt/static-server/
RUN npm ci --prefix /opt/static-server --omit=dev --ignore-scripts
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx
ENV PATH="/opt/static-server/node_modules/.bin:$PATH"

COPY --from=builder /app/dist/centro-ecuestre-reservas/browser ./dist

EXPOSE 8082

CMD ["serve", "-s", "./dist", "-l", "8082"]
